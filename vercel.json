{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/maintenance", "destination": "/exam-schedule-2nd-term", "permanent": false },
    { "source": "/maintenance.html", "destination": "/exam-schedule-2nd-term", "permanent": false }
  ],
  "rewrites": [
    { "source": "/amis_exam_calendar/:match*", "destination": "/:match*" },
    { "source": "/loads", "destination": "/loads.html" },
    { "source": "/loads-schedule", "destination": "/loads-schedule.html" },
    { "source": "/loads_schedule", "destination": "/loads_schedule/index.html" },
    { "source": "/loads_schedule/:match*", "destination": "/loads_schedule/:match*" },
    { "source": "/exam-schedule-2nd-term", "destination": "/exam-schedule-2nd-term.html" },
    { "source": "/grade-calendar-view-2nd-term", "destination": "/grade-calendar-view-2nd-term.html" },
    { "source": "/faculty-timetable/exam", "destination": "/faculty-timetable-exam.html" },
    { "source": "/proctor-list", "destination": "/proctor-list.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/class-schedule-manage", "destination": "/class-schedule-manage.html" },
    { "source": "/class-schedule-manage/create", "destination": "/class-schedule/create" },
    { "source": "/class-schedule-manage/edit", "destination": "/class-schedule/edit" },
    { "source": "/class-schedule/:id/edit", "destination": "/class-schedule/edit" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
