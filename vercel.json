{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/faculty-timetable/class", "destination": "/faculty-timetable-class.html" },
    { "source": "/faculty-timetable/exam", "destination": "/faculty-timetable-exam.html" },
    { "source": "/faculty-timetable-print", "destination": "/faculty-timetable-class.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
