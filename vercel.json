{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/faculty-timetable/exam", "destination": "/faculty-timetable-exam.html" },
    { "source": "/proctor-list", "destination": "/proctor-list.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/class-schedule-manage", "destination": "/class-schedule-manage.html" },
    { "source": "/class-schedule-manage/create", "destination": "/class-schedule/create" },
    { "source": "/class-schedule-manage/edit", "destination": "/class-schedule/edit" },
    { "source": "/class-schedule/:id/edit", "destination": "/class-schedule/edit" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
